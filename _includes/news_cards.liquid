<!--
  News cards (home page), newest first, same style as "Featured Research Projects".
  One card per file in _news/. Clicking a card opens the news detail page.
  Card fields come from the news front matter:
    title, date, summary (card text), images (first one is the card picture unless `cover` is set),
    cover (optional, file inside assets/img/), links (optional list of label + url).
-->
{% assign news_items = site.news | reverse %}
{% if news_items.size > 0 %}
  <div class="container news-cards" style="overflow-x: auto; white-space: nowrap; padding-bottom: 20px;">
    <div class="row flex-nowrap">
      {% for item in news_items %}
        {% assign anchor = item.date | date: '%Y-%m-%d' | prepend: 'news-' %}
        {% if item.cover %}
          {% assign cover_src = item.cover %}
        {% elsif item.images %}
          {% assign first_image = item.images | first %}
          {% assign cover_src = first_image.src %}
        {% else %}
          {% assign cover_src = null %}
        {% endif %}
        <div class="col-10 col-md-5 col-lg-4" id="{{ anchor }}">
          <div class="card h-100 shadow-sm news-card clickable-card" style="white-space: normal;">
            {% if cover_src %}
              <img
                src="{{ cover_src | prepend: '/assets/img/' | relative_url }}"
                class="card-img-top news-card-img"
                alt="{{ item.title | escape }}"
                loading="lazy"
              >
            {% endif %}
            <div class="card-body d-flex flex-column">
              <h6 class="card-title news-card-title">
                <a href="{{ item.url | relative_url }}" class="stretched-link">{{ item.title }}</a>
              </h6>
              <div class="card-text news-card-text">
                {% if item.summary %}
                  {{ item.summary | markdownify }}
                {% else %}
                  {{ item.content }}
                {% endif %}
              </div>
              <div class="news-card-footer mt-auto">
                <span class="badge badge-light">{{ item.date | date: '%b %d, %Y' }}</span>
                <a
                  href="{{ item.url | relative_url }}"
                  class="card-btn btn btn-sm btn-outline-dark"
                  style="font-size: 0.7rem; padding: 2px 8px; border-radius: 4px;"
                >
                  READ MORE
                </a>
                {% for link in item.links %}
                  {% if link.url contains '://' %}
                    {% assign href = link.url %}
                  {% else %}
                    {% assign href = link.url | relative_url %}
                  {% endif %}
                  <a
                    href="{{ href }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card-btn btn btn-sm btn-outline-dark"
                    style="font-size: 0.7rem; padding: 2px 8px; border-radius: 4px;"
                  >
                    {{- link.label -}}
                  </a>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
