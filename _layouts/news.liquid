---
layout: default
---
<!--
  Detail page for one news item (files in _news/).
  Front matter used: title, date, summary (card text on the home page), images, video, links.
  The body of the news file is the full text shown here.
-->
<div class="post news-post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta"><i class="fa-solid fa-calendar fa-sm"></i> {{ page.date | date: '%B %d, %Y' }}</p>
  </header>

  <article class="post-content">
    {{ content }}

    {% if page.links %}
      <div class="news-post-links">
        {% for link in page.links %}
          {% if link.url contains '://' %}
            {% assign href = link.url %}
          {% else %}
            {% assign href = link.url | relative_url %}
          {% endif %}
          <a
            href="{{ href }}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-outline-dark"
            style="font-size: 0.75rem; padding: 3px 10px; border-radius: 4px;"
          >
            {{- link.label -}}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% include news_gallery.liquid %}
  </article>

  <p class="news-post-back">
    <a href="{{ '/' | relative_url }}#news">&larr; Back to all news</a>
  </p>
</div>
