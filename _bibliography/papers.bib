@inproceedings{rocha2026xai,
  abbr        = {CCNEC},
  bibtex_show = {true},
  title       = {Explainable Machine Learning for Alzheimer's Disease Detection via Resting-State Electroencephalography},
  author      = {Rocha, T. S. and Gouveia, G. S. M. and Oliveira, S. I. A. and Brito, A. M. and Souto, S. F.},
  abstract    = {Electroencephalography (EEG) combined with machine learning has high potential for Alzheimer's disease (AD) screening. However, the clinical adoption of these technologies is hindered by the black-box nature of the algorithms, which classify patients without justifying their criteria. Explainable models are therefore needed to ensure that the model detects real neurophysiological changes rather than signal noise. This study aimed to develop a computational model to distinguish patients with AD from healthy controls and to map, through mathematical interpretability metrics, which EEG spectral signatures guide the classification. Resting-state EEG signals (BrainLat dataset; n = 90) from patients with AD and healthy controls were preprocessed (band-pass filtering, segmentation into 4-s epochs and within-subject normalization). Classic markers from the literature (relative powers, spectral ratios and entropy) fed the classifiers. To avoid bias and data leakage, the model was trained with subject-wise rather than group-wise validation. The most accurate model was dissected with SHAP, which quantifies the weight of each biomarker in the model's final decision. The optimized classifier achieved a discriminative capacity of 70%. Decoding the model revealed that it detected subjects with AD based on classic cortical slowing: increased relative theta power was the strongest single predictor, followed by the theta/alpha and theta/beta ratios. Notably, the AD probabilities estimated by the model correlated with decline on screening tests (MoCA, p = 0.010). The model distinguished healthy subjects from those with Alzheimer's disease and autonomously learned the slowing signature of dementia. Explainable AI contributes to the clinical relevance of spectral biomarkers, providing biological reliability to future models that support automated diagnosis.},
  booktitle   = {17th Courses and Conferences on Neuroscience and Behavior (CCNEC)},
  year        = {2026},
  month       = {Sep},
  award_name  = {2nd Place},
  award       = {2nd Place, Best Work Award at the 17th CCNEC, among 80 competing researchers.},
  preview     = {poster_rocha2026xai.jpg},
  selected    = {true},
  poster      = {poster_rocha2026xai.pdf},
  code        = {https://github.com/tiagosoutorocha-neuro/BrainLat_dataset_Alzheimer_EEG}
}

