@inproceedings{oliveira2026spectral,
  abbr        = {CCNEC},
  bibtex_show = {true},
  title       = {Beyond Spectral Power: A Comparative Study of EEG Biomarker Categories Using Machine Learning for Alzheimer's Disease Screening},
  author      = {Oliveira, S. I. A. and Souto, S. F. and Rocha, T. S. and Gouveia, G. S. M. and Paixão, L. M.},
  abstract    = {Early diagnosis of Alzheimer's disease is essential, and electroencephalography (EEG) stands out as a promising, non-invasive and accessible tool. Although the literature reports dozens of biomarkers focused on slowing, connectivity or complexity, most studies only compare classifiers using divergent methodological parameters, so it remains unclear which physiological categories offer the greatest discriminative capacity under identical experimental conditions. This study systematically compared the predictive performance of distinct categories of neurophysiological biomarkers for Alzheimer's disease screening. Features corresponding to spectral power, slowing (global mean frequency), complexity (Lempel-Ziv), connectivity (phase-amplitude coupling), systemic oscillations (Kuramoto order) and functional disorganization (mutual information) were extracted in five frequency bands from 65 participants (controls and patients with Alzheimer's disease). The discriminative power of these six categories was tested individually and in a multivariate model with three machine learning algorithms: random forest, support vector machine and extreme gradient boosting. Connectivity (phase-amplitude coupling) and signal complexity (Lempel-Ziv) showed the best individual performance, both reaching 75% precision, whereas classic decline markers such as slowing (mean frequency) and spectral power performed worst, between 56% and 70% accuracy. The multivariate signature integrating all categories outperformed the individual models, reaching 81% precision. Traditionally used biomarkers such as spectral power and slowing are not necessarily the most discriminative when compared under identical methodological conditions with connectivity and complexity biomarkers, reinforcing the central role of network connectivity and nonlinear dynamics in the pathophysiology of Alzheimer's disease and the importance of analyzing the brain as an integrated system.},
  booktitle   = {17th Courses and Conferences on Neuroscience and Behavior (CCNEC)},
  year        = {2026},
  month       = {Sep},
  preview     = {poster_oliveira2026spectral.jpg},
  poster      = {poster_oliveira2026spectral.pdf},
  code        = {https://github.com/SharaIsabell/eeg-alzheimer-biomarkers-analysis}
}

@inproceedings{brito2026sleep,
  abbr        = {CCNEC},
  bibtex_show = {true},
  title       = {Sleep, Depressive Symptoms, and Cognitive Performance in Older Adults: A Possible Mediation Pathway},
  author      = {Brito, A. M. and Rocha, T. S. and Alves, J. P. P. and Souto, S. F. and Santana, A. N.},
  abstract    = {Neuropsychiatric symptoms, such as depressive symptoms, and clinical manifestations, such as sleep changes, may emerge in the pre-dementia period, even before cognitive decline becomes evident, suggesting a pathway linking mental health and cognition in older adults. This study assessed whether sleep efficiency and depressive symptoms are associated with cognitive performance in older adults, with pre-specified directional hypotheses that worse sleep and greater severity of depressive symptoms relate to worse cognitive performance. This observational, analytical, cross-sectional study is a secondary analysis of the public RESILIENT dataset (approved by the London-Surrey Borders Research Ethics Committee), comprising 73 older adults with multiple chronic conditions. Participants aged 60 or older with complete data on sleep efficiency, depressive symptoms and cognitive performance were included; cases with missing data on these variables were excluded, resulting in samples of 54 to 69 participants depending on the association tested. Sleep efficiency was assessed with physiological monitoring mattresses, depressive symptoms with the Patient Health Questionnaire, and cognitive performance with the Addenbrooke's Cognitive Examination. Partial Spearman correlations controlling for age and sex were used. There was no significant correlation between sleep efficiency and cognitive performance (rho = 0.12; p = 0.19; N = 54), possibly due to the small sample size. Depressive symptoms correlated negatively with sleep efficiency (rho = -0.28; p = 0.01; N = 69) and with cognitive performance (rho = -0.33; p = 0.007; N = 54). The absence of a direct association between sleep and cognition, together with the correlations of depressive symptoms, suggests a possible indirect association between sleep and cognition rather than sleep acting in isolation. Depressive symptoms may represent a relevant target for the early prevention of cognitive decline in older adults; longitudinal studies with larger samples are needed to confirm this possible mediation pathway.},
  booktitle   = {17th Courses and Conferences on Neuroscience and Behavior (CCNEC)},
  year        = {2026},
  month       = {Sep},
  preview     = {poster_brito2026sleep.jpg},
  poster      = {poster_brito2026sleep.pdf}
}

@inproceedings{alves2026eegreview,
  abbr        = {CCNEC},
  bibtex_show = {true},
  title       = {Electroencephalography in the Detection of Alzheimer's Disease and Mild Cognitive Impairment: An Integrative Review},
  author      = {Alves, J. P. P. and Brito, A. M. and Rocha, T. S. and Oliveira, S. I. A. and Souto, S. F.},
  abstract    = {Alzheimer's disease (AD) and mild cognitive impairment (MCI) call for early and accessible detection strategies. Electroencephalography (EEG) is a promising candidate because it is low-cost, portable and non-invasive, although current methodological heterogeneity limits comparisons. This integrative review aimed to understand how electrophysiological data are processed and analyzed to predict AD and MCI, mapping acquisition parameters, band and connectivity patterns, preprocessing strategies and machine learning models. PubMed and IEEE Xplore were searched with the equation ("EEG" OR "electroencephalography") AND ("Alzheimer" OR "dementia") AND ("MCI") AND ("diagnosis" OR "connectivity"). Peer-reviewed empirical articles in English (2015-2025) comparing controls, MCI and AD in humans were included; simulated data, reviews, protocols and studies without a clear description of the methodology were excluded, for a total of 67 studies. Channels P4, P3 and F7 were the most used, with analyses concentrated on frontal, parietal and occipital regions. Hippocampal atrophy was reflected in temporal slowing and reduced complexity. The theta band was the earliest change, and disease progression was characterized by increased delta and theta, decreased alpha and beta, and reduced fronto-temporal connectivity. Standard preprocessing combined band-pass filtering, notch filtering and ICA to optimize the signal-to-noise ratio. Resting-state protocols with eyes closed predominated (19-32 electrodes, 250-512 Hz, 10-20 system), with screening by MMSE and MoCA. Resting-state, eyes-closed EEG protocols combined with spectral analyses, connectivity metrics and standardized cognitive instruments provide high discrimination between controls, MCI and AD. However, the clinical consolidation of EEG requires rigorous standardization and transparency of protocols.},
  booktitle   = {17th Courses and Conferences on Neuroscience and Behavior (CCNEC)},
  year        = {2026},
  month       = {Sep},
  preview     = {poster_alves2026eegreview.jpg},
  poster      = {poster_alves2026eegreview.pdf}
}

